{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tsbuildinfo/node",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
