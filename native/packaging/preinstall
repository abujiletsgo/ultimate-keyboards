#!/bin/bash
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
[ "${3:-/}" = / ] || { echo 'Install to the running system volume only.' >&2; exit 1; }
base='/Library/Application Support/com.ultimatekeyboards.app'
daemon='/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/Applications/Karabiner-VirtualHIDDevice-Daemon.app'
manager='/Applications/.Karabiner-VirtualHIDDevice-Manager.app'
receipt='/var/db/receipts/org.pqrs.Karabiner-DriverKit-VirtualHIDDevice.plist'
# Refuse symlink or writable ancestors before any privileged payload is copied.
for path in /Library '/Library/Application Support' "$base" "$base/Native" "$base/Native/state" /Library/LaunchDaemons /Library/LaunchAgents; do
  [ ! -L "$path" ] || { echo "Unsafe symlink: $path" >&2; exit 1; }
  if [ -e "$path" ]; then
    [ -d "$path" ] && [ "$(stat -f %u "$path")" = 0 ] || { echo "Untrusted directory: $path" >&2; exit 1; }
    mode=$(stat -f %Lp "$path")
    [ $((0$mode & 0022)) = 0 ] || { echo "Writable directory: $path" >&2; exit 1; }
  fi
done
if [ -e "$daemon" ]; then
  [ ! -L "$daemon" ] || exit 1
  version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$daemon/Contents/Info.plist")
  case "$version" in 8.5.0|8.6.0) ;; *) echo "Shared driver $version is not in the compatibility allowlist; setup stopped." >&2; exit 1;; esac
  codesign --verify --strict --deep -R='anchor apple generic and certificate leaf[subject.OU] = "G43BCU2T37" and identifier "org.pqrs.Karabiner-VirtualHIDDevice-Daemon"' "$daemon"
elif [ -e "$manager" ] || [ -e "$receipt" ]; then
  echo 'Incomplete shared driver installation; setup cannot safely replace it.' >&2
  exit 1
fi
exit 0
